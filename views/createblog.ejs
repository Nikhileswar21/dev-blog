<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/css/bootstrap') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>create blog</title>
</head>
<body>
    <%- include('./partials/components/nav') %>
    <div class="container">
         <div class="my-5">
    <h1>Create a New Blog</h1>
   </div>
   <form  enctype="multipart/form-data" method = "post" action="/blog/create">
    <div class="mb-3">
       <label  for="coverImg" class="form-label">cover image</label> 
       <input name="coverImg" type="file">
    </div>
    <div class="mb-3 ">

    <label for="title" class="form-label">Title</label>
    <input name="title" 
    type="text" 
    class="form-control" 
    id="title" 
    aria-describedby="title">
    </div>
    <div class="mb-3">
         <label for="content" class="form-label">Content</label>
         <textarea name="content" class="form-control" id="content"></textarea>
    </div>
    <button type="submit" class="btn btn-primary " style="background-color: #2e4a1e;">Post Blog</button>
   </form>
    </div>
  

    
    
    <%- include('./partials/js/bootstrap') %>
</body>
</html>