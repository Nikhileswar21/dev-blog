<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/css/bootstrap') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home page</title>
</head>
<body>
    <%- include('./partials/components/nav') %>
   
    <div class="container">
        <div class="row mt-5">
        <% blogs.forEach(blog => { %>
         <div class="card mx-2 col" style="width: 18rem;">
  <img src="/uploads/<%= blog.coverImg %>" class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title"><%= blog.title.slice(0,60) %></h5>
    <a href="/blogs/view<%= blog._id %>" class="btn btn-primary">view full blog</a>
  </div>
</div>
        <% }) %>
        </div>
    </div>

    <%- include('./partials/js/bootstrap') %>
</body>
</html>